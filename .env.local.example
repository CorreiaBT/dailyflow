# Copie este arquivo para .env.local e preencha as chaves que você tiver.
# O app funciona sem nenhuma delas (usa cache/fallback local), mas fica
# melhor com elas configuradas.

# Cotações B3 (brapi.dev) — opcional, sem token o rate limit é menor.
BRAPI_TOKEN=

# Consultor de Investimentos com IA (Google AI Studio, gratuito):
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
